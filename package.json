    "@scure/bip39": "2.4.0",
    "express": "5.3.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "7.0.5",
    "bolt11": "1.4.2",
    "esbuild": "0.28.2",
    "tiny-secp256k1": "^2.2.5"
  }
